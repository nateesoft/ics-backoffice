{
    "templates": [
        {
            "templateId": "simple-crud-app-v1",
            "name": "Simple CRUD Application",
            "description": "Reusable CRUD template: list / search / view / create / update / delete for a single resource.",
            "architecture": {
                "type": "web-application",
                "frontend": "nextjs",
                "backend": "nestjs",
                "database": "postgresql"
            },
            "components": [
                {
                    "type": "mainPage",
                    "name": "MainPage",
                    "description": "Show Main Page",
                    "jsonSchema": {
                        "type": "object",
                        "properties": {
                            "appTitle": {
                                "type": "string",
                                "default": "ICS Backoffice",
                                "description": "ชื่อระบบที่แสดงบน header"
                            },
                            "menuItems": {
                                "type": "array",
                                "description": "รายการเมนูฝั่งซ้าย สร้างจาก components ที่ type = page ของแต่ละ config ใน template",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "id": { "type": "string" },
                                        "label": { "type": "string" },
                                        "icon": { "type": "string" },
                                        "componentName": {
                                            "type": "string",
                                            "description": "ชื่อ page component (ตรงกับ components[].name ที่ type = page) ที่จะ render ฝั่งขวาเมื่อเลือกเมนูนี้"
                                        },
                                        "path": { "type": "string" }
                                    },
                                    "required": ["id", "label", "componentName"]
                                }
                            },
                            "selectedMenuId": {
                                "type": ["string", "null"],
                                "default": null,
                                "description": "id ของเมนูที่กำลังถูกเลือกอยู่ในปัจจุบัน"
                            },
                            "breadcrumb": {
                                "type": "array",
                                "description": "breadcrumb path ที่ update ทุกครั้งที่เลือกเมนูฝั่งซ้าย",
                                "items": {
                                    "type": "object",
                                    "properties": {
                                        "label": { "type": "string" },
                                        "path": { "type": "string" }
                                    },
                                    "required": ["label"]
                                },
                                "default": [{ "label": "Home", "path": "/" }]
                            },
                            "isSidebarOpen": {
                                "type": "boolean",
                                "default": true,
                                "description": "สถานะเปิด/ปิด left side menu — บน desktop default true (fixed), บน mobile/tablet default false (overlay)"
                            },
                            "viewport": {
                                "type": "string",
                                "enum": ["mobile", "tablet", "desktop"],
                                "default": "desktop",
                                "description": "breakpoint ปัจจุบัน ใช้ควบคุม responsive behavior ของ header และ sidebar"
                            }
                        },
                        "required": ["menuItems", "breadcrumb"]
                    },
                    "uiElements": [
                        {
                            "elementType": "header",
                            "name": "MainHeader",
                            "sticky": true,
                            "responsive": {
                                "mobile": { "showHamburgerMenu": true, "showLogo": true, "showSearch": false },
                                "tablet": { "showHamburgerMenu": true, "showLogo": true, "showSearch": true },
                                "desktop": { "showHamburgerMenu": false, "showLogo": true, "showSearch": true }
                            },
                            "children": [
                                {
                                    "elementType": "button",
                                    "name": "HamburgerMenuButton",
                                    "icon": "menu",
                                    "visibleOn": ["mobile", "tablet"],
                                    "onClick": {
                                        "action": "toggleSidebar",
                                        "steps": [
                                            { "setState": { "isSidebarOpen": "${!isSidebarOpen}" } }
                                        ]
                                    }
                                },
                                {
                                    "elementType": "text",
                                    "name": "AppTitle",
                                    "bind": "${appTitle}"
                                },
                                {
                                    "elementType": "userMenu",
                                    "name": "UserProfileMenu",
                                    "props": { "showAvatar": true, "showLogout": true }
                                }
                            ]
                        },
                        {
                            "elementType": "sidebar",
                            "name": "LeftSideMenu",
                            "position": "left",
                            "responsive": {
                                "mobile": { "mode": "overlay", "visible": "${isSidebarOpen}" },
                                "tablet": { "mode": "overlay", "visible": "${isSidebarOpen}" },
                                "desktop": { "mode": "fixed", "visible": true }
                            },
                            "dataSource": "${menuItems}",
                            "itemTemplate": {
                                "elementType": "menuItem",
                                "bind": "item",
                                "props": {
                                    "label": "${item.label}",
                                    "icon": "${item.icon}",
                                    "active": "${item.id === selectedMenuId}"
                                },
                                "onClick": {
                                    "action": "selectMenu",
                                    "steps": [
                                        { "setState": { "selectedMenuId": "${item.id}" } },
                                        { "setState": { "breadcrumb": [{ "label": "Home", "path": "/" }, { "label": "${item.label}", "path": "${item.path}" }] } },
                                        { "setState": { "isSidebarOpen": false }, "condition": "${viewport !== 'desktop'}" },
                                        {
                                            "renderUI": {
                                                "target": "MainContentArea",
                                                "component": "${item.componentName}"
                                            }
                                        }
                                    ]
                                }
                            }
                        },
                        {
                            "elementType": "overlay",
                            "name": "MobileSidebarBackdrop",
                            "visibleOn": ["mobile", "tablet"],
                            "visible": "${isSidebarOpen}",
                            "onClick": {
                                "action": "toggleSidebar",
                                "steps": [
                                    { "setState": { "isSidebarOpen": false } }
                                ]
                            }
                        },
                        {
                            "elementType": "container",
                            "name": "MainContentArea",
                            "position": "right",
                            "children": [
                                {
                                    "elementType": "breadcrumb",
                                    "name": "ContentBreadcrumb",
                                    "dataSource": "${breadcrumb}",
                                    "separator": "/",
                                    "itemTemplate": {
                                        "elementType": "breadcrumbItem",
                                        "bind": "crumb",
                                        "props": {
                                            "label": "${crumb.label}",
                                            "path": "${crumb.path}"
                                        }
                                    }
                                },
                                {
                                    "elementType": "dynamicComponent",
                                    "name": "PageContent",
                                    "description": "แสดง page component ฝั่งขวาตาม selectedMenuId — component คือ page ของแต่ละ config ที่สร้างไว้ใน components list",
                                    "component": "${selectedMenuId ? menuItems.find(m => m.id === selectedMenuId).componentName : defaultComponentName}",
                                    "fallback": {
                                        "elementType": "emptyState",
                                        "name": "NoMenuSelectedState",
                                        "message": "กรุณาเลือกเมนูฝั่งซ้ายเพื่อแสดงเนื้อหา"
                                    }
                                }
                            ]
                        }
                    ]
                },
                {
                    "type": "page",
                    "name": "ProductListPage",
                    "description": "Show Product List Page",
                    "jsonSchema": {},
                    "uiElements": []
                },
                {
                    "type": "modal",
                    "name": "ViewProductModal",
                    "description": "Show View Product Modal",
                    "jsonSchema": {},
                    "uiElements": []
                },
                {
                    "type": "global-alert",
                    "name": "InfoAlert",
                    "description": "Show Info Alert",
                    "jsonSchema": {},
                    "uiElements": []
                },
                {
                    "type": "component",
                    "name": "CalendarComponent",
                    "description": "Show Calendar Component",
                    "jsonSchema": {},
                    "uiElements": []
                }
            ],
            "backendServices": {
                "productService": {
                    "routes": [
                        {
                            "name": "getProducts",
                            "method": "GET",
                            "path": "/products",
                            "queryParameters": {},
                            "payload": {},
                            "logicPipeline": [
                                {
                                    "queryList": {
                                        "limit": 100,
                                        "orderBy": "code",
                                        "orderByType": "asc"
                                    },
                                    "assignTo": "products"
                                },
                                {
                                    "responseJson": {
                                        "status": 200,
                                        "message": "Show all products successfully",
                                        "data": "${products}"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "getProductsById",
                            "method": "GET",
                            "path": "/products/:id",
                            "queryParameters": {},
                            "payload": {},
                            "logicPipeline": [
                                {
                                    "validateParams": [
                                        {
                                            "parameter": "id",
                                            "type": "number",
                                            "required": true
                                        }
                                    ]
                                },
                                {
                                    "filterBy": "id = :id",
                                    "assignTo": "product"
                                },
                                {
                                    "responseJson": {
                                        "status": 200,
                                        "message": "Show product by id: ${id} successfully",
                                        "data": "${product}"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "searchProducts",
                            "method": "GET",
                            "path": "/products/search",
                            "queryParameters": {
                                "code": {
                                    "type": "string",
                                    "required": false
                                },
                                "name": {
                                    "type": "string",
                                    "required": false
                                }
                            },
                            "payload": {},
                            "logicPipeline": [
                                {
                                    "filterBy": "code ILIKE :code AND name ILIKE :name",
                                    "orderBy": "code",
                                    "orderByType": "asc",
                                    "assignTo": "products"
                                },
                                {
                                    "responseJson": {
                                        "status": 200,
                                        "message": "Search products successfully",
                                        "data": "${products}"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "createProduct",
                            "method": "POST",
                            "path": "/products",
                            "queryParameters": {},
                            "payload": {
                                "code": "P001",
                                "name": "Laptop",
                                "price": 999.99
                            },
                            "logicPipeline": [
                                {
                                    "validatePayloads": [
                                        {
                                            "parameter": "code",
                                            "type": "string",
                                            "required": true
                                        },
                                        {
                                            "parameter": "name",
                                            "type": "string",
                                            "required": true
                                        },
                                        {
                                            "parameter": "price",
                                            "type": "number",
                                            "required": true
                                        }
                                    ]
                                },
                                {
                                    "generateFields": [
                                        {
                                            "parameter": "id",
                                            "type": "number",
                                            "autogenerate": true
                                        }
                                    ]
                                },
                                {
                                    "executeInsert": true,
                                    "assignTo": "product"
                                },
                                {
                                    "responseJson": {
                                        "status": 201,
                                        "message": "Product created successfully",
                                        "data": "${product}"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "updateProduct",
                            "method": "PUT",
                            "path": "/products/:id",
                            "queryParameters": {},
                            "payload": {
                                "code": "P001",
                                "name": "Laptop",
                                "price": 899.99
                            },
                            "logicPipeline": [
                                {
                                    "validateParams": [
                                        {
                                            "parameter": "id",
                                            "type": "number",
                                            "required": true
                                        }
                                    ]
                                },
                                {
                                    "validatePayloads": [
                                        {
                                            "parameter": "code",
                                            "type": "string",
                                            "required": true
                                        },
                                        {
                                            "parameter": "name",
                                            "type": "string",
                                            "required": true
                                        },
                                        {
                                            "parameter": "price",
                                            "type": "number",
                                            "required": true
                                        }
                                    ]
                                },
                                {
                                    "filterBy": "id = :id"
                                },
                                {
                                    "executeUpdate": true,
                                    "assignTo": "product"
                                },
                                {
                                    "responseJson": {
                                        "status": 200,
                                        "message": "Product updated successfully",
                                        "data": "${product}"
                                    }
                                }
                            ]
                        },
                        {
                            "name": "deleteProduct",
                            "method": "DELETE",
                            "path": "/products/:id",
                            "queryParameters": {},
                            "payload": {},
                            "logicPipeline": [
                                {
                                    "validateParams": [
                                        {
                                            "parameter": "id",
                                            "type": "number",
                                            "required": true
                                        }
                                    ]
                                },
                                {
                                    "filterBy": "id = :id"
                                },
                                {
                                    "executeDelete": true,
                                    "assignTo": "product"
                                },
                                {
                                    "responseJson": {
                                        "status": 200,
                                        "message": "Product deleted successfully",
                                        "data": "${product}"
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            "workflows": [
                {
                    "pageName": "productListPage",
                    "frontendURL": "/products",
                    "pageAction": [
                        {
                            "type": "initialLoad",
                            "steps": [
                                {
                                    "apiCall": {
                                        "method": "GET",
                                        "path": "/products"
                                    },
                                    "params": {},
                                    "payload": {}
                                },
                                {
                                    "responseMapping": {
                                        "products": "${response.data}"
                                    }
                                },
                                {
                                    "renderUI": {
                                        "component": "ProductListPage",
                                        "props": {
                                            "products": "${products}"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "onClickSearch",
                            "steps": [
                                {
                                    "apiCall": {
                                        "method": "GET",
                                        "path": "/products/search"
                                    },
                                    "params": {
                                        "code": "${searchCode}",
                                        "name": "${searchName}"
                                    },
                                    "payload": {}
                                },
                                {
                                    "responseMapping": {
                                        "products": "${response.data}"
                                    }
                                },
                                {
                                    "renderUI": {
                                        "component": "ProductListPage",
                                        "props": {
                                            "products": "${products}"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "onClickView",
                            "steps": [
                                {
                                    "apiCall": {
                                        "method": "GET",
                                        "path": "/products/:id"
                                    },
                                    "params": {
                                        "id": "${selectedProductId}"
                                    },
                                    "payload": {}
                                },
                                {
                                    "responseMapping": {
                                        "product": "${response.data}"
                                    }
                                },
                                {
                                    "renderUI": {
                                        "component": "ViewProductModal",
                                        "props": {
                                            "product": "${product}"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "onClickCreate",
                            "steps": [
                                {
                                    "apiCall": {
                                        "method": "POST",
                                        "path": "/products"
                                    },
                                    "params": {},
                                    "payload": {
                                        "code": "${newProductCode}",
                                        "name": "${newProductName}",
                                        "price": "${newProductPrice}"
                                    }
                                },
                                {
                                    "responseMapping": {
                                        "product": "${response.data}"
                                    }
                                },
                                {
                                    "renderUI": {
                                        "component": "ProductListPage",
                                        "props": {
                                            "products": "${products}"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "onClickUpdate",
                            "steps": [
                                {
                                    "apiCall": {
                                        "method": "PUT",
                                        "path": "/products/:id"
                                    },
                                    "params": {
                                        "id": "${selectedProductId}"
                                    },
                                    "payload": {
                                        "code": "${updatedProductCode}",
                                        "name": "${updatedProductName}",
                                        "price": "${updatedProductPrice}"
                                    }
                                },
                                {
                                    "responseMapping": {
                                        "product": "${response.data}"
                                    }
                                },
                                {
                                    "renderUI": {
                                        "component": "ProductListPage",
                                        "props": {
                                            "products": "${products}"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "type": "onClickDelete",
                            "steps": [
                                {
                                    "apiCall": {
                                        "method": "DELETE",
                                        "path": "/products/:id"
                                    },
                                    "params": {
                                        "id": "${selectedProductId}"
                                    },
                                    "payload": {}
                                },
                                {
                                    "responseMapping": {
                                        "product": "${response.data}"
                                    }
                                },
                                {
                                    "renderUI": {
                                        "component": "ProductListPage",
                                        "props": {
                                            "products": "${products}"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "profiles": [
        {
            "profileId": 12345,
            "type": "client",
            "name": "Tech Solutions Inc.",
            "description": "A leading provider of innovative technology solutions.",
            "parentAgencyId": null,
            "projects": [
                {
                    "id": 1,
                    "name": "Simple CRUD Application",
                    "description": "A simple CRUD application for managing user data.",
                    "templateId": "simple-crud-app-v1",
                    "data": {
                        "products": [
                            {
                                "id": 1,
                                "name": "Laptop",
                                "price": 999.99
                            },
                            {
                                "id": 2,
                                "name": "Smartphone",
                                "price": 699.99
                            },
                            {
                                "id": 3,
                                "name": "Tablet",
                                "price": 399.99
                            },
                            {
                                "id": 4,
                                "name": "Headphones",
                                "price": 199.99
                            },
                            {
                                "id": 5,
                                "name": "Smartwatch",
                                "price": 249.99
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
